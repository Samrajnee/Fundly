datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LivingSituation {
  WITH_PARENTS
  RENTING_ALONE
  RENTING_SHARED
  OWN_HOME
}

enum IncomeType {
  FIXED_SALARY
  IRREGULAR
  FREELANCE
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String
  passwordHash     String
  livingSituation  LivingSituation?
  incomeType       IncomeType       @default(FIXED_SALARY)
  supportsFamily   Boolean          @default(false)
  isFirstSalary    Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  salaryProfiles   SalaryProfile[]
  transactions     Transaction[]
  categories       Category[]
  recurringExpenses RecurringExpense[]
  goals            Goal[]
  budgets          Budget[]
  investments      Investment[]
  debts            Debt[]
  insurancePolicies InsurancePolicy[]
}

model SalaryProfile {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  monthlySalary     Decimal  @db.Decimal(12, 2)
  necessitiesAmount Decimal  @db.Decimal(12, 2)
  lifestyleAmount   Decimal  @db.Decimal(12, 2)
  savingsAmount     Decimal  @db.Decimal(12, 2)
  investmentsAmount Decimal  @db.Decimal(12, 2)
  goalsAmount       Decimal  @db.Decimal(12, 2)
  bufferAmount      Decimal  @db.Decimal(12, 2)

  effectiveFrom     DateTime @default(now())
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, isActive])
}

enum CategoryType {
  NECESSITY
  LIFESTYLE
  SAVINGS
  INVESTMENT
  GOAL
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  type      CategoryType
  isDefault Boolean      @default(false)

  transactions Transaction[]
  recurringExpenses RecurringExpense[]
  budgets          Budget[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
}

enum TransactionSource {
  MANUAL
  AI_PARSED
  RECURRING
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId  String
  category    Category          @relation(fields: [categoryId], references: [id])

  amount      Decimal           @db.Decimal(12, 2)
  merchant    String?
  note        String?
  date        DateTime
  source      TransactionSource @default(MANUAL)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, date])
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model RecurringExpense {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category            @relation(fields: [categoryId], references: [id])

  label      String
  amount     Decimal             @db.Decimal(12, 2)
  frequency  RecurrenceFrequency @default(MONTHLY)
  dueDay     Int?
  isActive   Boolean             @default(true)

  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

model Goal {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  targetAmount   Decimal    @db.Decimal(12, 2)
  currentAmount  Decimal    @db.Decimal(12, 2) @default(0)
  targetDate     DateTime
  monthlyRequired Decimal   @db.Decimal(12, 2)
  status         GoalStatus @default(ACTIVE)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Budget {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])

  monthlyLimit  Decimal  @db.Decimal(12, 2)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, categoryId])
}

enum InvestmentType {
  MUTUAL_FUND
  FIXED_DEPOSIT
  PPF
  EPF
  NPS
  STOCKS
  OTHER
}

model Investment {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           InvestmentType
  name           String
  investedAmount Decimal        @db.Decimal(12, 2)
  currentValue   Decimal        @db.Decimal(12, 2)
  startDate      DateTime
  notes          String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum DebtType {
  CREDIT_CARD
  PERSONAL_LOAN
  HOME_LOAN
  VEHICLE_LOAN
  EDUCATION_LOAN
  OTHER
}

model Debt {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type               DebtType
  lender             String
  principalAmount    Decimal  @db.Decimal(12, 2)
  outstandingAmount  Decimal  @db.Decimal(12, 2)
  interestRate       Decimal  @db.Decimal(5, 2)
  emiAmount          Decimal  @db.Decimal(12, 2)
  tenureMonths       Int
  startDate          DateTime

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum InsuranceType {
  HEALTH
  LIFE
  VEHICLE
  HOME
  OTHER
}

enum PremiumFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

model InsurancePolicy {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type             InsuranceType
  provider         String
  coverageAmount   Decimal          @db.Decimal(12, 2)
  premiumAmount    Decimal          @db.Decimal(12, 2)
  premiumFrequency PremiumFrequency @default(YEARLY)
  expiryDate       DateTime
  notes            String?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}